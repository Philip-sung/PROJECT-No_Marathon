# ── no-marathon.kr 환경 변수 ──────────────────────────────
# 복사: cp .env.example .env.local  (.env.local 은 git 무시됨)
# dev 에서는 MOCK 모드로 secret 없이 동작한다.

# 실행 모드: 'mock'(개발 기본, 외부호출 없음) | 'live'(실제 Supabase/Claude)
NEXT_PUBLIC_APP_MODE=mock

# 모킹 데이터셋(mock 모드에서만): file(폴더 JSON, 권장) | default(= file) | empty(빈 상태)
MOCK_DATASET=file
# 읽을 폴더(기본 mock-data). marathons.json/disruptions.json/comments.json
MOCK_DATA_DIR=mock-data

# ── Supabase ───────────────────────────────────────────
# live 모드에서만 필요. mock 모드면 비워둬도 됨.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(절대 NEXT_PUBLIC_ 접두어 금지, 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API (Phase 7 수집 에이전트) ──────────────────
ANTHROPIC_API_KEY=
# 수집 에이전트 트리거(cron/webhook) 인증 토큰. 임의의 긴 문자열.
AGENT_TRIGGER_SECRET=
# 알림/escalation Slack incoming webhook(선택).
SLACK_WEBHOOK_URL=
# 간이 백오피스(/admin) 관리자 번호(임의의 긴 문자열). 미설정 시 dev 무인증.
ADMIN_PASSCODE=

# ── 수집 리포트 메일(네이버 SMTP) ──────────────────────
# 수집(수동/cron)이 끝나면 내용·토큰 소모량·비용(USD)을 메일로 발송.
# send-naver-mail 스킬과 동일한 자격증명(앱 비밀번호). 미설정 시 발송은 조용히 생략.
NAVER_MAIL_USER=
NAVER_MAIL_APP_PASSWORD=
# 리포트 수신 주소(미설정 시 NAVER_MAIL_USER 로 자기 자신에게 발송).
COLLECTION_REPORT_EMAIL=

# ── 비즈니스/분석 ──────────────────────────────────────
# AdSense 게시자 ID(ca-pub-...). 미설정 시 placeholder 표시.
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense 광고 단위 slot id(숫자). 디스플레이 단위 표시에 필요(Auto Ads 만 쓰면 불필요).
NEXT_PUBLIC_ADSENSE_SLOT=

# ── 운영 secret ────────────────────────────────────────
# 앱 불편신고 수신 메일 (개발자가 주입). 코드에 하드코딩 금지.
REPORT_INBOX_EMAIL=
# 기기 해시 salt (익명 식별 안정화). prod 에서는 임의의 긴 문자열 주입.
DEVICE_HASH_SALT=
