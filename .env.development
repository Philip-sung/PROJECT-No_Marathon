# ── 개발 환경 (next dev 가 자동 로드) ───────────────────────
# mock 모드 — 이번에 수집·정제한 mock 데이터(mock-data/*.json)를 표시.
# 비밀키 없이 동작. 실제 외부호출(Supabase/Claude) 없음.
NEXT_PUBLIC_APP_MODE=mock
MOCK_DATASET=file
MOCK_DATA_DIR=mock-data

# (선택) dev 에서 수집 리포트 메일을 테스트하려면 NAVER 자격증명을
# .env.development.local (gitignore 됨) 에 넣으세요. 여기(커밋 파일)엔 비밀 금지.

# live 미사용 — 비워둠
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
